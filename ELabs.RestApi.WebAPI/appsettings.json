{
  "ConnectionStrings": {
    "ELabs_Northwind": "Server=localhost;Database=Northwind;Integrated Security=true;TrustServerCertificate=true",
    "ELabs_AWConnection": "Server=localhost;Database=AdventureWorks2025;Integrated Security=true;TrustServerCertificate=true",
    "ELabs_AWDWConnection": "Server=localhost;Database=AdventureWorksDW2025;Integrated Security=true;TrustServerCertificate=true"
  },
  "Auth": {
    "AllowedGatewayAccount": "REPLACE_WITH_DOMAIN\\GatewayAccount"
  },
  "Serilog": {
    "Properties": {
      "TableName": "ELabs_REST_API_Logs"
    },
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
