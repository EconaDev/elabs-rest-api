<?xml version="1.0" encoding="utf-8"?>
<!-- LOCAL DEBUGGING ONLY (Visual Studio / IIS Express). Never copy this to a server:
     server web.config files come from DeploymentConfigs\web.<Environment>.config.
     Authentication for IIS Express is controlled by iisSettings in Properties\launchSettings.json,
     so there is intentionally no <security> block here. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
